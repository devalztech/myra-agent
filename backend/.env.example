# ---- server ----------------------------------------------------------
# Pterodactyl sets SERVER_PORT automatically; PORT works elsewhere.
PORT=8000
HOST=0.0.0.0
MYRA_DEBUG=0

# ---- auth ------------------------------------------------------------
MYRA_JWT_SECRET=change-me-to-a-long-random-string
MYRA_JWT_EXPIRE_MINUTES=10080

# ---- cors ------------------------------------------------------------
# Comma-separated origins, or * for any (default).
MYRA_CORS_ORIGINS=*

# ---- database --------------------------------------------------------
# PostgreSQL when set; otherwise SQLite at <repo>/database/myra.db
# DATABASE_URL=postgresql://myra:secret@127.0.0.1:5432/myra
# or the discrete form:
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=myra
# POSTGRES_PASSWORD=secret
# POSTGRES_DB=myra

# ---- cloudflare tunnel ----------------------------------------------
# With CLOUDFLARE_TUNNEL_TOKEN set: named tunnel on your own stable hostname
# (configured once in the Cloudflare dashboard under Public Hostname).
# Set PUBLIC_API_URL to that hostname so /health can report it immediately.
# Without a token: a random https://<random>.trycloudflare.com URL is
# created and printed at boot (also written to .bin/tunnel_url.txt).
# CLOUDFLARE_TUNNEL_TOKEN=
# PUBLIC_API_URL=https://api.example.com
# MYRA_SKIP_TUNNEL=0

# ---- local model -----------------------------------------------------
# llama_cpp (default, local GGUF) | mock (no model, canned replies)
MYRA_LLM_BACKEND=llama_cpp
# Tier is chosen automatically from the panel's RAM. Override if needed:
# MYRA_MODEL_REPO=bartowski/Meta-Llama-3.1-8B-Instruct-GGUF
# MYRA_MODEL_FILE=Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
# MYRA_MODEL_PATH=/absolute/path/to/model.gguf
# MYRA_RAM_GB=16
MYRA_RAM_RESERVE_GB=1.5
MYRA_MAX_TOKENS=1024
MYRA_TEMPERATURE=0.4
MYRA_THREADS=0
MYRA_GPU_LAYERS=0
MYRA_PRELOAD_MODEL=0
MYRA_HISTORY_WINDOW=20

# NOTE on "Bad gateway" (Cloudflare error 502) with a named tunnel:
# 1. The origin must be addressed as 127.0.0.1, not localhost — "localhost"
#    resolves to ::1 (IPv6) while uvicorn on 0.0.0.0 only listens on IPv4.
#    The app now passes --url http://127.0.0.1:$PORT to cloudflared itself,
#    which overrides whatever the dashboard config says.
# 2. The hostname's DNS record must be the CNAME to
#    <tunnel-id>.cfargotunnel.com that Cloudflare creates when you add a
#    Public Hostname to the tunnel. A proxied A/AAAA record on that hostname
#    causes a permanent 502 even though cloudflared reports "Registered
#    tunnel connection" — the edge never forwards the request to it.
