# When editing this env, make it neat like this: no too many comments, and add space between sections.

# --- server ---
PORT=8000
HOST=0.0.0.0
MYRA_DEBUG=0

# --- auth ---
MYRA_JWT_SECRET=change-me-to-a-long-random-string
MYRA_JWT_EXPIRE_MINUTES=10080
MYRA_ALLOWED_EMAILS=

MYRA_CORS_ORIGINS=*

# --- tunnel / public URL ---
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_API_URL=https://your-tunnel-url.example.com
MYRA_SKIP_TUNNEL=0

# --- local model (3 GB RAM / 200% CPU tuning) ---
# llama_cpp = on-device inference (optional). Set to mock to skip the local
# model entirely and run purely on remote providers.
MYRA_LLM_BACKEND=llama_cpp
MYRA_MODEL_TIER=coder-nano
MYRA_RAM_RESERVE_GB=1.0
MYRA_MAX_AUTO_MODEL_GB=1.0
MYRA_MAX_TOKENS=512
MYRA_TEMPERATURE=0.4
MYRA_THREADS=2
MYRA_BATCH_SIZE=256
MYRA_GPU_LAYERS=0
MYRA_PRELOAD_MODEL=1
MYRA_HISTORY_WINDOW=10
MYRA_USE_MMAP=1
MYRA_USE_MLOCK=0
MYRA_LLM_KV_CACHE=1
MYRA_LLM_KV_CACHE_MB=256

# --- providers ---
# The remote providers are free OpenAI-compatible APIs — set the matching
# *_API_KEY to enable them. Myra auto-fails-over across them in this order:
# groq -> sambanova -> scaleway -> pollinations -> (local last resort).
#   groq      — highest free tier (llama-3.1-8b-instant ~14.4k req/day)
#   sambanova — free hosted DeepSeek/Llama/MiniMax (70B brains)
#   scaleway  — free hosted llama/mistral/qwen
#   pollinations — keyless (no key needed), flaky free tier
MYRA_DEFAULT_PROVIDER=groq
AGNES_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
SAMBANOVA_API_KEY=
SCALEWAY_API_KEY=
# pollinations is keyless — no key needed, leave blank
POLLINATIONS_BASE_URL=https://text.pollinations.ai/openai
POLLINATIONS_MODEL=openai

# --- agent / workspace ---
MYRA_APPROVAL_REQUIRED=0
MYRA_WORKSPACE_DIR=/home/container/myra
MYRA_ENABLE_NETWORK_TOOLS=1
MYRA_ENABLE_BROWSER_TOOLS=1
MYRA_MAX_TOOL_CALLS=24
MYRA_MAX_AGENT_STEPS=12
MYRA_TOOL_TIMEOUT=120
MYRA_AGENT_TIMEOUT=900
